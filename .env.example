# ==============================================================================
# 古诗词视觉化意境生成器 (Poetry-to-Art Pipeline) 配置文件模板
# 请将此文件复制为 .env 并填写您的 API 密钥与代理配置
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 诗词解析引擎配置 (大语言模型 API - 支持所有兼容 OpenAI 格式的接口)
# ------------------------------------------------------------------------------
# 推荐使用：DeepSeek, SiliconFlow, 智谱清言, OpenAI 等
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 2. 图像生成引擎配置 (文生图 API)
# ------------------------------------------------------------------------------
# 支持 provider 选项: "huggingface" 或 "siliconflow"
T2I_PROVIDER=siliconflow
T2I_API_KEY=your_t2i_api_key_here

# 针对 huggingface 推荐模型: black-forest-labs/FLUX.1-schnell 或 stabilityai/stable-diffusion-xl-base-1.0
# 针对 siliconflow 推荐模型: black-forest-labs/FLUX.1-schnell 或 stabilityai/stable-diffusion-3-medium
T2I_MODEL=black-forest-labs/FLUX.1-schnell

# ------------------------------------------------------------------------------
# 3. 网络代理配置 (国内网络访问 HuggingFace/OpenAI 必填)
# ------------------------------------------------------------------------------
# 如果本地运行了 Clash/V2Ray 等代理客户端，请填写对应的代理端口（例如 127.0.0.1:7890）
# 若不需要使用代理，留空即可
HTTP_PROXY=
HTTPS_PROXY=
